{
	"Q": {
		"pluginInfo": {
			"Media": {
				"version": "0.4.5",
				"compatible": "0.1",
				"requires": {
					"Q": "1.0",
					"Users": "1.0",
					"Streams": "1.0",
					"Websites": "1.0",
					"Calendars": "0.1"
				},
				"permissions": [],
				"connections": ["Users", "Streams", "Websites"]
			}
		},
		"handlersBeforeEvent": {
			"Q/responseExtras": ["Media/before/Q_responseExtras"],
			"Streams/close/Media/feed": ["Media/before/Streams_close_Media_feed"],
			"Streams/close/Media/webrtc/waitingRoom": ["Media/before/Streams_close_Media_webrtc_waitingRoom"]
		},
		"handlersAfterEvent": {
			"Streams/create/Media/episode": ["Media/after/Streams_create_Media_episode"],
			"Streams/create/Media/clip": ["Media/after/Streams_create_Media_clip"],
			"Streams/create/Media/channel": ["Media/after/Streams_create_Media_channel"],
			"Streams/relateTo/Streams/chat": ["Media/after/Streams_relateTo_Streams_chat"],
			"Streams/message/Streams/closed": ["Media/after/Streams_message_Streams_closed"],
			"Communities/community/tabs": ["Media/after/Communities_community_tabs"],
			"Communities/profile/tabs": ["Media/after/Communities_profile_tabs"],
			"Db/Row/Users_Contact/saveExecute": ["Media/after/Users_Contact_saveExecute"],
			"Db/Row/Users_Contact/removeExecute": ["Media/after/Users_Contact_removeExecute"],
			"Users/Label/can": ["Media/after/Users_Label_can"],
			"Streams/message/Streams/join": ["Media/after/Streams_message_Streams_join"],
			"Streams/message/Streams/leave": ["Media/after/Streams_message_Streams_leave"],
			"Streams/message/Media/livestream/start": ["Media/after/Streams_message_Media_livestream_start"],
			"Streams/message/Media/livestream/stop": ["Media/after/Streams_message_Media_livestream_stop"],
		},
		"text": {
			"Media": {
				"*": ["Streams/content", "Media/content"]
			}
		},
		"routes@start": {
			"clip/:clipId": {"module": "Media", "action": "clip"},
			"clip/:publisherId/:clipId": {"module":  "Media", "action":  "clip"},
			"clip/:publisherId/:episodeDate/:clipTime": {"module":  "Media", "action":  "clip"},
			"clip/:publisherId/:clipId/edit": {"module": "Media", "action": "episodeEdit"},
			"clips": {"module":  "Media", "action":  "clips"},
			"youtube": {"module":  "Media", "action":  "youtube"},
			"youtube/:videoId/": {"module":  "Media", "action":  "clip"},
            "Media/youtube/webhook": {"module": "Media", "action": "yt"},
			"livestream/:publisherId/:livestreamId": { "module": "Media", "action": "livestream" },
			"livestream/:publisherId/:livestreamId[]": {"module": "Media", "action": "livestream"},
		    "meeting": { "module": "Media", "action": "meeting" },
		    "clipEditor": { "module": "Media", "action": "clipEditor" },
            "Media/clipEditor/webhook": {"module": "Media", "action": "clipEditor"},
		    "livestreamAuth": { "module": "Media", "action": "livestreamAuth" },
			"Media/dropVideo": {"module": "Media", "action": "dropVideo"},
			"games": {"module":  "Media", "action":  "games"},
			"games/:publisherId/:clipId": {"module":  "Media", "action":  "games"},
		    "callCenter": { "module": "Media", "action": "callCenter" },
			"feeds": {"module": "Media", "action": "feeds"},
			"feed/:feedId": { "module": "Media", "action": "feed" },
			"newFeed": {"module": "Media", "action": "newFeed"},
			"presentation/:calendarId": {"module": "Media", "action": "presentation"},
			"presentation/:calendarId/control": { "module": "Media", "action": "commands" },
			"presentation/:communityId/:calendarId": {"module": "Media", "action": "presentation"},
			"presentation/:communityId/:calendarId/control": { "module": "Media", "action": "commands" },
			"channels": {"module": "Media", "action": "channels"},
			"channels/:publisherId": {"module": "Media", "action": "channels"},
			"channel": {"module": "Media", "action": "channel"},
			"channel/:publisherId": {"module": "Media", "action": "channel"},
			"channel/:publisherId/:channelId": {"module": "Media", "action": "channel"}
		},
		"web": {
			"contentSecurityPolicy": {
				"script": ["https://www.youtube.com", "https://cdnjs.cloudflare.com", "https://accounts.google.com/gsi/client"]
			}
		},
		"images": {
			"Media/episode": {
				"sizes": ["40", "50", "80", "200", "400", "x400", "400x"],
				"defaultSize": "50",
				"maxStretch": 40
			},
			"Media/clip": {
				"sizes": ["40", "50", "80", "200", "400", "x400", "400x"],
				"defaultSize": "50",
				"maxStretch": 40
			}
		}
	},
	"Users": {
		"quotas": {
			"Media/webrtc": {
				"86400": {
					"": 10,
					"Users/owners": 1000,
					"Users/admins": 1000
				}
			}
		},
		"onInsert": {
			"roles": {
				"Media/admins": ["Media admins", "labels/Media/admins"],
				"Users/hosts": ["Hosts", "labels/Users/hosts"],
				"Users/screeners": ["Screeners", "labels/Users/screeners"]
			}
		},
		"notifications": {
			"notices": { /* track message type to show notification as Q.Notice */
				"Livestream/reminder": {
					"timeout": 10
				}
			}
		},
		"roles": {
			"Users/owners": {
				"canGrant": ["Media/admins"],
				"canRevoke": ["Media/admins"]
			},
			"Users/admins": {
				"canGrant": ["Media/admins"],
				"canRevoke": ["Media/admins"]
			},
			"Users/members": {
				"canSee": ["Users/hosts", "Users/screeners"]
			},
			"Users/guests": {
				"canSee": ["Users/hosts", "Users/screeners"]
			},
			"Users/hosts": {
				"title": "Show Hosts",
				"icon": "{{Users}}/img/icons/labels/Media/hosts",
				"canGrant": ["Users/members", "Users/guests", "Users/screeners"],
				"canRevoke": ["Users/members", "Users/guests", "Users/screeners"],
				"canSee": ["Users/owners", "Users/admins", "Users/members", "Users/guests", "Media/admins", "Users/hosts", "Users/screeners"]
			},
			"Media/admins": {
				"title": "Media Admins",
				"icon": "{{Users}}/img/icons/labels/Media/admins",
				"canGrant": ["Media/admins", "Users/hosts", "Users/screeners"],
				"canRevoke": ["Media/admins", "Users/hosts", "Users/screeners"],
				"canSee": ["Users/owners", "Users/admins", "Users/members", "Users/guests", "Media/admins", "Users/hosts", "Users/screeners"]
			},
			"Users/screeners": {
				"title": "Call Screeners",
				"icon": "{{Users}}/img/icons/labels/Media/screeners",
				"canGrant": [],
				"canRevoke": [],
				"canSee": ["Users/owners", "Users/admins", "Users/members", "Users/guests", "Media/admins", "Users/hosts", "Users/screeners"]
			},
			"": {
				"canSee": ["Media/admins", "Media/hosts"]
			}
		},
		"capability": {
			"public": {
				"presentation/:calendarId": ["s"],
				"livestream/:publisherId/:livestreamId[]": ["s"],
				/* Keyed by bare action name (not a route pattern, unlike the
				   two above) because Users_before_Q_sessionExtras() reads
				   Q_Config::get('Users','capability','public',$uri->action).
				   Lets a not-logged-in visitor open the Safecloud Jet socket
				   connection teaser playback needs — otherwise
				   Q.Socket.connect.validateAuth() (Users.js) rejects any
				   socket connection whenever the session's capability has
				   an empty permissions array, which is the default for
				   every not-logged-in session (Users/socket is only added
				   for a logged-in user). The real security boundary for
				   what a teaser viewer can decrypt is Safecloud's own
				   signed grant, checked per-chunk by the service worker —
				   this only clears Qbix's generic "can this session open a
				   socket at all" gate. */
				"clip": ["Safecloud/socket"]
			}
		}
	},
	"Streams": {
		"chat": {
			"allowedRelatedStreams": ["Media/webrtc"]
		},
		"userStreams": {
			"Media": "streams.json"
		},
		"onInsert": { /* streams to insert when a row is inserted */
			"community": [
				"Media/calls/main"
			]
		},
		"types": {
			"*": {
				"relatedTo": {
					"Media/webrtc": {
						"description": ["Media/content", ["notifications", "Streams/relatedTo/Media/call"]]
					}
				}
			},
			"Streams/chat": {
				"emoji": "💬",
				"create": true,
				"edit": ["icon", "title", "content"],
				"subscriptions": {
					"filter": {
						"types": ["Media/call"]
					}
				},
				"messages": {
					"Media/call": {
						"description": ["Streams/content", ["description", "Media/call"]],
						"subject": ["Streams/content", ["notifications", "Media/call"]]
					}
				}
			},
			"Media/presentation": {
				"emoji": "👨🏻‍🏫",
				"create": true,
				"edit": true,
				"defaults": {
					"title": "Presentation",
					"icon": "{{Media}}/img/icons/Media/presentation",
					"readLevel": 40,
					"writeLevel": 16,
					"adminLevel": 10
				},
				"ephemerals": {
					"Media/presentation/show": {},
                    "Media/presentation/reaction/burst": {},
                    "Media/presentation/graph/update":   {},
                    "Media/presentation/table/update":   {},
                    "Streams/gallery/query":             {},
                    "Streams/gallery/images":            {},
                    "Streams/gallery/next":              {},
                    "Streams/gallery/pause":             {},
                    "Streams/gallery/resume":            {},
                    "Streams/gallery/add":               {},
                    "Streams/gallery/caption":           {},
                    "Streams/gallery/remove":            {},
                    "Streams/gallery/transition":        {},
                    "Streams/slide":                     {},
                    "Streams/play":                      {},
                    "Streams/pause":                     {},
                    "Streams/seek":                      {},
                    "Streams/reveal":                    {},
                    "Streams/zoom":                      {},
                    "Streams/highlight":                 {},
                    "Q/style":                           {},
                    "Q/scroll":                          {},
                    "Q/fullscreen":                      {},
                    "AI/tool/generated":                 {},
                    "Media/slide/build":                 {}
                },
                "messages": {
					"Media/presentation/show": {},
                    "Media/presentation/start":       {},
                    "Media/presentation/end":         {},
                    "Media/presentation/slide":       {},
                    "Media/presentation/card/show":   {},
                    "Media/presentation/reaction":    {},
                    "Media/presentation/transcript":  {},
                    "Media/presentation/topic":       {},
                    "Media/presentation/tool/show":   {},
                    "Media/presentation/access":      {},
                    "Media/presentation/graph/update":{},
                    "Media/presentation/table/update":{},
                    "Media/presentation/pin":         {},
                    "Media/presentation/unpin":       {},
                    "Media/presentation/resize":      {},
                    "Media/presentation/reorder":     {}
                }
			},
			"Media/presentation/slide": {
				"emoji": "🌠",
				"create": true,
				"edit": true,
				"defaults": {
					"title": "Untitled Slide",
					"icon": "{{Media}}/img/icons/Media/presentation/slide",
					"readLevel": 20,
					"writeLevel": 0,
					"adminLevel": 10
				},
				"extend": ["Media_Slide"]
			},
			"Media/webrtc": {
				"emoji": "🧑🏻‍💻",
				"defaults": {
					"title": "Teleconference",
					"icon": "{{Media}}/img/icons/Media/webrtc"
				},
				"edit": ["title", "content", "attributes"],
				"messages": {
					"Media/webrtc/joined": {}
				}
			},
			"Media/webrtc/livestream": {
				"emoji": "📡",
				"defaults": {
					"title": "Livestream",
					"icon": "{{Media}}/img/icons/Media/webrtc/livestream",
					"readLevel": 40,
					"writeLevel": 23,
					"adminLevel": 20
				},
				"edit": ["title"],
				"url": "{{baseUrl}}/livestream/{{publisherId}}/{{name}}",
				"ephemerals": {
					"Media/livestream/reaction": {}
				},
				"messages": {
					"Livestream/reminder": {
						"subject": ["Calendars/content", ["notifications", "Calendars/reminder"]]
					},
					"Media/livestream/start": {
						"subject": ["Calendars/content", ["notifications", "livestream", "Started"]]
					}
				}
			},
			"Media/webrtc/chat": {
				"emoji": "💭",
				"defaults": {
					"title": "Chat",
					"icon": "Streams/chat",
					"readLevel": 40,
					"writeLevel": 10,
					"adminLevel": 20
				},
				"edit": ["title"],
				"create": true,
				"url": "{{baseUrl}}/livestream/{{publisherId}}/{{name}}"
			},
			"Media/calls": {
				"emoji": "🧏",
				"create": false,
				"edit": ["attributes"]
			},
			"Media/channel": {
				"defaults": {
					"icon": "Streams/category",
					"title": "Untitled Media Channel",
					"readLevel": 40,
					"writeLevel": 10,
					"adminLevel": 20
				},
				"create": true,
				"close": true,
				"edit": [
					"title",
					"icon",
					"content",
					"attributes"
				],
				"uri": "Media/channel publisherId={{publisherId}} channelId={{streamName.[2]}}",
				"url": "{{baseUrl}}/channel/{{publisherId}}/{{streamName.[2]}}",
				"messages": {
					/* Media/dropVideo relates each new episode to the uploader's
					   channel, which posts a "Streams/relatedTo" message here.
					   By default (Streams/types/[]), notify() only emails/
					   notifies a participant who is OFFLINE -- someone online
					   just gets a silent socket push with no visible notice
					   (see Streams/notifications/notices, fixed separately)
					   and no Streams_Notification row at all. A channel
					   follower who happens to be online when the creator
					   uploads should still get a real notification, so this
					   type overrides evenIfOnline to true, scoped to
					   Media/channel only (see Streams_Stream::getConfigField /
					   Node Streams_Stream.getConfigField, which merges this
					   over the Streams/types/[] default per stream type). */
					"Streams/relatedTo": {
						"evenIfOnline": true,
						/* Without this, the email subject falls back to the
						   platform default ("{{{call 'message.getInstruction'
						   'description'}}}"), which here resolves to the raw,
						   unrendered relate() config array stored verbatim in
						   the message's own instructions (confirmed live --
						   a real sent email had the literal subject
						   "Streams/content,notifications,Streams/relatedTo/[]"
						   -- that array's own toString(), not a template bug
						   on our end). fromAvatar is fetched specifically for
						   this (see Streams_Message.prototype.deliver in
						   classes/Streams/Message.js, gated by fetchAvatar
						   below) as the uploader's avatar, as seen by the
						   recipient, so a nickname the recipient set for
						   them is respected same as elsewhere on the
						   platform. */
						"subject": "{{{call 'fromAvatar.displayName'}}} uploaded a new video",
						"fetchAvatar": true
					}
				}
			},
			"Media/clip": {
				"emoji": "🎬",
				"defaults": {
					"icon": "{{Media}}/img/icons/Media/clip",
					"title": "Untitled Media Clip",
					"readLevel": 40,
					"writeLevel": 10,
					"adminLevel": 20
				},
				"create": true,
				"close": true,
				"edit": [
					"title",
					"content",
					"attributes"
				],
				"uri": "Media/clip publisherId={{publisherId}} clipId={{streamName.[2]}}",
				"url": "{{baseUrl}}/clip/{{publisherId}}/{{streamName.[2]}}"
			},
			"Media/episode": {
				"emoji": "📺",
				"defaults": {
					"icon": "{{Media}}/img/icons/Media/episode",
					"title": "Untitled Episode",
					"readLevel": 40,
					"writeLevel": 23,
					"adminLevel": 20
				},
				"create": true,
				"close": true,
				"edit": [
					"title",
					"content",
					"attributes"
				],
				"uri": "Media/clip publisherId={{publisherId}} clipId={{streamName.[2]}}",
				"url": "{{baseUrl}}/clip/{{publisherId}}/{{streamName.[2]}}",
				"syncRelations": ["from"]
			},
			"Media/movie": {
				"emoji": "📽️",
				"create": true
			},
			"Media/feed": {
				"emoji": "🎥",
				"create": false,
				"close": true,
				"edit": [
					"title",
					"content",
					"attributes"
				],
				"defaults": {
					"icon": "{{Media}}/img/icons/Media/feed",
					"readLevel": 0,
					"writeLevel": 0,
					"adminLevel": 0
				},
				"messages": {
					"Media/feed/started": {
						"description": "Media feed started",
						"subject": [
							"Media/content",
							[
								"notifications",
								"Media/feed/started"
							]
						]
					},
					"Media/feed/access": {
						"description": "Media feed access requested",
						"subject": [
							"Media/content",
							[
								"notifications",
								"Media/feed/access"
							]
						]
					}
				}
			}
		},
		"commands": {
			"Media": {
				"slide/navigate": {
					"routing": "immediate",
					"handler": "Media.commands.slideNavigate",
					"description": "Navigate to a slide by semantic title/content search"
				}
			}
		}
	},
	"Assets": {
		"credits": {
			"amounts": {
				"watching": "1"
			},
			"commissions": {
				"watching": "1%"
			}
		},
		"payments": {
			"reasons": {
				"EpisodeAccess": {
					"withoutIntentToken": {
						"currency": "USD",
						"min": 0,
						"max": 1000
					}
				}
			}
		}
	},
	"Media": {
		"clip": {
			"openFirstClip": { /* if no clipId defined expand first clip and open */
				"desktop": true,
				"mobile": false
			},
			"watching": {
				"earnPeriod": 60, /* seconds */
				"metricsPeriod": 60 /* seconds — how often Streams.Metrics
				   batches up watched-ranges and POSTs them to Streams/metrics;
				   see Media/clip/videoPlayer's (Safecloud/video, Q/video,
				   Q/audio) metrics option. Anyone watching less than this
				   many seconds produces zero streams_metrics rows at all —
				   not a partial record, nothing — since the POST only
				   happens on this timer, never on page unload/pause. */
			},
			"createCost": { /* charge credits for clip create */
				"amount": 20,
				"currency": "credits"
			},
			"webrtc": {
				"relations": {
					"main": "Media/webrtc/main",
					"waiting": "Media/webrtc/waiting"
				}
			},
			/* "allUsers" (default): any logged-in viewer with access to an
			   episode can create their own clip of it (and the "Allow
			   people to share a clip" checkbox shows at upload/edit time).
			   "publisher": only the episode's own creator can create clips
			   from it — the checkbox is hidden entirely, and the server
			   (Media_clip_saveSafecloudClip) rejects anyone else's attempt
			   even via a direct POST, not just a hidden button. */
			"allowCreateForRole": "allUsers",
			/* "tabs" | "columns" — which Media/clip/<layout> template
			   Media/clip.js renders by default (see its own "layout" state
			   option doc comment). */
			"clipToolLayout": "columns",
			/* "default" | "cards" | "largeThumbCard" — which layout
			   Media/episode/preview.js renders by default (see its own
			   "layout" state option doc comment). */
			"episodePreviewLayout": "default",
			/* Minimum width in px each "cards"/"largeThumbCard" preview is
			   allowed to shrink to before another grid column is added, i.e.
			   how many fit per row (see Media/episode/preview.js's own
			   "cardMinWidth" state option doc comment). null leaves the
			   grid's own CSS default (300px) in place. */
			"episodePreviewCardMinWidth": null,
			/* Whether clicking a Media/episode/preview card while another
			   episode's detail column is already open updates that column's
			   content in place (see Q/columns open()'s own "replace" option
			   doc comment) instead of closing it and animating in a new one.
			   false leaves the platform default (close + reopen) behavior. */
			"episodePreviewReplaceColumn": false,
			/* "searchAndColumnTitle" | "searchBarOnly" -- which layout
			   Media/clip/search.js renders by default (see its own
			   "layout" state option doc comment). */
			"clipSearchLayout": "searchAndColumnTitle",
			/* "cards" | "searchResultCard" -- which Media/episode/preview
			   layout clipSearch.js's own results use (see its own comment
			   right above where it reads this). */
			"clipSearchResultLayout": "cards"
		},
		"channel": {
			/* Whether channels get an explicit Follow/Subscribe/Mute/Unfollow
			   mechanism (see Media/channel.js and Media/clip.js's joinClip()).
			   Defaults to false so existing apps keep today's original behavior
			   unchanged -- watching a video still auto-joins the viewer to the
			   uploader's channel as a bare (unsubscribed) participant, and no
			   Follow button is shown. Apps that want the new mechanism (e.g.
			   Fans, via its own local/app.json) override this to true. */
			"allowFollow": false,
			/* Whether Media/channel.js shows the full Streams/participants
			   list (today's original behavior) or just a "<N> followers"
			   count in its place. Defaults to true so existing apps keep
			   seeing the list unchanged; apps that want the compact count
			   instead (e.g. Fans, via its own local/app.json) override
			   this to false. */
			"showParticipants": true,
			/* Which Q.Template.render(...) Media/channel/preview.js uses for
			   each row of a channel list (see views/Media/column/channels.php).
			   "default" (the platform default) keeps today's original
			   behavior unchanged -- the generic Streams/default/preview tool,
			   icon+title only, same as every other stream type gets by
			   default. "mediaChannel" uses the dedicated 'Media/channel/
			   mediaChannel' template instead (avatar, title, follower count,
			   description, and a Follow button, Spotify-podcast-style) --
			   opt in app by app (e.g. Fans, via its own local/app.json), not
			   a platform-wide default, since it assumes a dark background. */
			"previewLayout": "default"
		},
		"episode": {
			"templateStyle": "classic", /* can be "classic", "square", "tall" */
			/* Which payment mechanisms the /dropVideo upload form offers for NEW
			   uploads. One or both of "perStream", "perMinute". This ONLY affects
			   which fields the upload form shows going forward — playback/gating
			   always reads the mechanism straight off each episode's own stored
			   payment attribute, so changing this never affects existing episodes. */
			"paymentMechanism": ["perStream", "perMinute"],
			"payment": { /* default prices offered on the Media/dropVideo upload form; 0 = free/disabled */
				"currency": "credits",
				"amount": 0, /* one-time price for full-episode access */
				"perMinute": 0 /* price per minute of watching, when set directly (perMinute-only mechanism) */
			}
		},
		"pageSizes": {
			"clips": 50,
			"channels": 50,
			"feeds": 100
		},
